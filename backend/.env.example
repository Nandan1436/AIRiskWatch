# --- Database ---
# Neon connection string (direct endpoint, not -pooler), with ?sslmode=require.
DATABASE_URL=

# Old local Docker database; still used by scripts/import_seed.py.
POSTGRES_DB=airiskwatch
POSTGRES_USER=airiskwatch
POSTGRES_PASSWORD=airiskwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

SEED_DATA_DIR=./MIT_AI_RISK_REPOSITORY/backup-20260601120109

# --- LLM ---
# gemini | groq
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# One key for all Groq models: openai/gpt-oss-120b | qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2048

LLM_MAX_RPM=10
LLM_TIMEOUT_S=60

# --- Search ---
SEARCH_CANDIDATE_K=30
SEARCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Ingestion ---
# In-process daily scheduler; run uvicorn with a single worker if enabled.
INGESTION_ENABLED=false
INGESTION_CRON_HOUR=3
INGESTION_TIMEZONE=Asia/Dhaka
INGESTION_MAX_ARTICLES_PER_SOURCE=20
INGESTION_LOOKBACK_HOURS=24
INGESTION_SIMILARITY_THRESHOLD=0.85
INGESTION_RELEVANCE_MIN_CONFIDENCE=0.6
INGESTION_USER_AGENT=AIRiskWatchBot/1.0 (+https://github.com/Nandan1436/AIRiskWatch; academic research project)
INGESTION_REQUEST_DELAY_S=2.0
INGESTION_HTTP_TIMEOUT_S=20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Same OAuth Web client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# --- Monthly digest email ---
# Gmail: smtp.gmail.com, port 587, an App Password. Empty SMTP_HOST disables sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173
DIGEST_EMAIL_ENABLED=false
DIGEST_CRON_HOUR=8
