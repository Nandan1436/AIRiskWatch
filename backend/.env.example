POSTGRES_DB=airiskwatch
POSTGRES_USER=airiskwatch
POSTGRES_PASSWORD=airiskwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Path to the AI Incident Database seed CSV dump (relative to backend/)
SEED_DATA_DIR=./MIT_AI_RISK_REPOSITORY/backup-20260601120109

# --- LLM classification (Phase 2) ---
# Which provider create_llm_client() uses: gemini | mistral | groq | ollama
LLM_PROVIDER=gemini

# Primary: Google Gemini free tier (native JSON-schema output). NOTE: the older
# gemini-2.5-flash-lite / gemini-2.5-flash are closed to new API keys — use a
# current flash-lite (e.g. gemini-3.5-flash-lite, or the gemini-flash-lite-latest alias).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Second provider: Mistral "Experiment" free tier (no daily request cap)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Smoke-test/fallback: Groq free tier (100K tokens/day — not for the full batch)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local comparison run only (never the full batch on 8GB RAM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Client-side pacing / timeout (keep at/below the provider's requests-per-minute)
LLM_MAX_RPM=10
LLM_TIMEOUT_S=60

# --- Semantic-search reranking ---
SEARCH_CANDIDATE_K=30
SEARCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
