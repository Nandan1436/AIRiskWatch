POSTGRES_DB=airiskwatch
POSTGRES_USER=airiskwatch
POSTGRES_PASSWORD=airiskwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Path to the AI Incident Database seed CSV dump (relative to backend/)
SEED_DATA_DIR=./MIT_AI_RISK_REPOSITORY/backup-20260601120109

# --- LLM classification (Phase 2) ---
# Which provider create_llm_client() uses: gemini | mistral | groq | ollama
LLM_PROVIDER=gemini

# Primary: Google Gemini free tier (native JSON-schema output). NOTE: the older
# gemini-2.5-flash-lite / gemini-2.5-flash are closed to new API keys — use a
# current flash-lite (e.g. gemini-3.5-flash-lite, or the gemini-flash-lite-latest alias).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Second provider: Mistral "Experiment" free tier (no daily request cap)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Smoke-test/fallback: Groq free tier (100K tokens/day — not for the full batch)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local comparison run only (never the full batch on 8GB RAM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Client-side pacing / timeout (keep at/below the provider's requests-per-minute)
LLM_MAX_RPM=10
LLM_TIMEOUT_S=60

# --- News ingestion pipeline (Phase 4+7 merged) ---
# Starts the in-process daily scheduler. OFF by default on purpose: enabling it
# means the server hits live news feeds and spends LLM quota on its own.
#
# IMPORTANT: safe only with a SINGLE app worker. Every uvicorn worker runs its
# own copy of the lifespan hook, so `--workers N` starts N schedulers. The
# advisory lock stops them running concurrently, but N-1 wake-ups are wasted.
# The dev command (`uvicorn app.main:app --reload`) is already single-worker.
#
# The CLI (`python scripts/run_ingestion.py`) ignores this flag entirely — use
# it with OS-level cron instead of the in-process scheduler if you prefer.
INGESTION_ENABLED=false

# Daily run time. The timezone is explicit because a bare hour is ambiguous in a
# container, where the process default is usually UTC.
INGESTION_CRON_HOUR=3
INGESTION_TIMEZONE=Asia/Dhaka

# Per-source cap on article pages fetched per run; bounds both HTTP traffic
# and LLM spend.
INGESTION_MAX_ARTICLES_PER_SOURCE=20

# Only articles published within this many hours of the run are ingested.
INGESTION_LOOKBACK_HOURS=24

# Cosine similarity at/above which a scraped report is treated as belonging to
# an incident already in the corpus (same convention as semantic search).
# A tunable starting heuristic, NOT a validated constant.
INGESTION_SIMILARITY_THRESHOLD=0.85

# Minimum confidence for the relevance filter to accept an article as a real AI
# incident. Raise it to be stricter — a false positive corrupts the corpus,
# a false negative just misses one article.
INGESTION_RELEVANCE_MIN_CONFIDENCE=0.6

# Identifying User-Agent, sent on every request including robots.txt fetches.
# Never set this to a spoofed browser string.
INGESTION_USER_AGENT=AIRiskWatchBot/1.0 (+https://github.com/Nandan1436/AIRiskWatch; academic research project)

# Politeness delay between requests, and per-request timeout.
INGESTION_REQUEST_DELAY_S=2.0
INGESTION_HTTP_TIMEOUT_S=20
