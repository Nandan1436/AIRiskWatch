flowchart TB
    subgraph CLIENT["Client tier: React 18 + TypeScript SPA (Vite)"]
        direction TB
        P["<b>Pages and Containers</b><br/>Overview, Incidents, Search, Taxonomy,<br/>Digest, Account, Admin"]
        H["<b>Hooks</b><br/>TanStack React Query"]
        SM["<b>Service modules</b><br/>incident, search, auth, ..."]
        AC["<b>apiClient</b> (Axios)<br/>+ AuthContext (JWT)"]
        P --> H --> SM --> AC
    end

    subgraph APP["Application tier: FastAPI backend (single Uvicorn process)"]
        direction TB
        R["<b>Route layer</b>: 12 APIRouters<br/>Pydantic request/response schemas<br/>auth guards: get_current_user, require_admin"]
        SCH["<b>APScheduler</b> (lifespan)<br/>daily ingestion, monthly digest"]
        SV["<b>Service layer</b>: business logic<br/>Incident, Search, Ingestion, LLM Classification,<br/>Digest, Auth, User, Admin, Summary, ..."]
        CC["<b>Core clients</b><br/>llm_client, embedding_client, reranker_client,<br/>news_client + site scrapers, security (bcrypt/JWT),<br/>google_auth_client, email_client"]
        M["<b>Model layer</b>: SQLAlchemy ORM<br/>Incident, Report, MitClassification,<br/>User, DigestDelivery"]
        R --> SV
        SCH --> SV
        SV --> CC
        SV --> M
    end

    subgraph EXT["External services"]
        direction LR
        LLM["<b>LLM provider</b><br/>Gemini / Groq"]
        NEWS["<b>News sites</b><br/>Wired, The Daily Star"]
        GID["<b>Google Identity</b><br/>OAuth ID token"]
        SMTP["<b>SMTP server</b>"]
    end

    LOCAL["<b>Local models</b><br/>MiniLM embedding (384-d)<br/>MiniLM cross-encoder reranker"]

    subgraph DATA["Data tier"]
        DB[("<b>Neon PostgreSQL</b><br/>+ pgvector")]
    end

    AC -- "HTTPS / JSON (REST), Bearer JWT" --> R
    CC --> LLM
    CC --> NEWS
    CC --> GID
    CC --> SMTP
    CC --> LOCAL
    M -- "SQL via psycopg2" --> DB

    classDef client fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef app fill:#DCFCE7,stroke:#16A34A,color:#0F172A
    classDef sched fill:#FEF3C7,stroke:#D97706,color:#0F172A
    classDef ext fill:#FFEDD5,stroke:#EA580C,color:#0F172A
    classDef local fill:#FEF9C3,stroke:#CA8A04,color:#0F172A
    classDef data fill:#EDE9FE,stroke:#7C3AED,color:#0F172A
    class P,H,SM,AC client
    class R,SV,CC,M app
    class SCH sched
    class LLM,NEWS,GID,SMTP ext
    class LOCAL local
    class DB data
    style CLIENT fill:#EFF6FF,stroke:#93C5FD
    style APP fill:#F0FDF4,stroke:#86EFAC
    style EXT fill:#FFF7ED,stroke:#FDBA74
    style DATA fill:#F5F3FF,stroke:#C4B5FD
