stateDiagram-v2
    classDef start fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef busy fill:#FEF3C7,stroke:#D97706,color:#0F172A
    classDef done fill:#DCFCE7,stroke:#16A34A,color:#0F172A
    classDef error fill:#FEE2E2,stroke:#DC2626,color:#0F172A

    state "Ready" as Ready
    state "Running<br/><i>button disabled, spinner shown</i>" as Running
    state "Run finished<br/><i>summary: completed, partial or skipped</i>" as RunFinished
    state "Error message" as ErrorMessage

    [*] --> Ready: open Admin, Ingestion tab
    Ready --> Running: press Run ingestion
    Running --> RunFinished: run summary<br/>returned
    RunFinished --> Running: press Run<br/>ingestion again
    Running --> ErrorMessage: request fails
    ErrorMessage --> Running: retry

    class Ready start
    class Running busy
    class RunFinished done
    class ErrorMessage error
