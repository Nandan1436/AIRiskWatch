stateDiagram-v2
    classDef start fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef busy fill:#FEF3C7,stroke:#D97706,color:#0F172A
    classDef done fill:#DCFCE7,stroke:#16A34A,color:#0F172A
    classDef empty fill:#FFEDD5,stroke:#EA580C,color:#0F172A
    classDef error fill:#FEE2E2,stroke:#DC2626,color:#0F172A

    state "Loading" as Loading
    state "Error message" as ErrorMessage
    state "Incidents listed" as IncidentsListed
    state "Updating" as Updating
    state "No matches" as NoMatches

    [*] --> Loading: open Incidents page
    Loading --> ErrorMessage: request fails
    Loading --> IncidentsListed: incidents returned
    Loading --> NoMatches: zero incidents match
    IncidentsListed --> [*]: open an incident
    IncidentsListed --> Updating: type keywords /<br/>change filter / change page
    Updating --> IncidentsListed: incidents returned
    Updating --> NoMatches: zero incidents match
    NoMatches --> Updating: change or clear filters

    class Loading busy
    class Updating busy
    class IncidentsListed done
    class NoMatches empty
    class ErrorMessage error
