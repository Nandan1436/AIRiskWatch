stateDiagram-v2
    classDef start fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef input fill:#EDE9FE,stroke:#7C3AED,color:#0F172A
    classDef busy fill:#FEF3C7,stroke:#D97706,color:#0F172A
    classDef done fill:#DCFCE7,stroke:#16A34A,color:#0F172A
    classDef empty fill:#FFEDD5,stroke:#EA580C,color:#0F172A
    classDef error fill:#FEE2E2,stroke:#DC2626,color:#0F172A

    state "Idle" as Idle
    state "Query entered" as QueryEntered
    state "Searching" as Searching
    state "Results shown<br/><i>facets and paging filter in place</i>" as ResultsShown
    state "Error message" as ErrorMessage
    state "No filter match" as NoFilterMatch

    [*] --> Idle: open Search page
    Idle --> QueryEntered: type a description
    QueryEntered --> Idle: clear the text
    QueryEntered --> Searching: press Search / Enter
    Searching --> ResultsShown: results and<br/>summary<br/>received
    ResultsShown --> Searching: submit a<br/>new query
    Searching --> ErrorMessage: request fails
    ErrorMessage --> Searching: submit again
    ResultsShown --> NoFilterMatch: facets exclude<br/>every result
    NoFilterMatch --> ResultsShown: remove a facet
    ResultsShown --> [*]: open an incident

    class Idle start
    class QueryEntered input
    class Searching busy
    class ResultsShown done
    class NoFilterMatch empty
    class ErrorMessage error
