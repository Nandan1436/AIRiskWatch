%%{init: {"sequence": {"height": 95}}}%%
sequenceDiagram
    autonumber
    actor U as User
    box rgb(219,234,254) Frontend
        participant SPA as React SPA<br/>(AuthContext)
    end
    box rgb(220,252,231) Backend
        participant AR as auth_route
        participant AS as AuthService
    end
    box rgb(255,237,213) External
        participant G as Google<br/>Identity
    end
    box rgb(243,232,255) Data
        participant DB as PostgreSQL
    end
    box rgb(220,252,231) Backend
        participant PR as Protected<br/>route
    end

    alt email and password
        U->>SPA: Enter email<br/>and password
        SPA->>AR: POST /api/auth/login
        AR->>AS: login(email, password)
        AS->>DB: SELECT user by email
        AS->>AS: bcrypt verify<br/>password<br/>#nbsp;
    else Google sign-in
        U->>SPA: Click #quot;Sign in<br/>with Google#quot;
        SPA->>G: Google Identity popup
        G-->>SPA: ID token (credential)
        SPA->>AR: POST /api/auth/google<br/>{credential}
        AR->>G: Verify ID token signature and audience
        AR->>AS: login_with_google<br/>(identity)
        AS->>DB: Find or create user<br/>by google_sub / email
    end
    alt wrong credentials / disabled account
        AR-->>SPA: 401 Unauthorized /<br/>403 Forbidden
    else success
        AS-->>AR: User
        AR-->>SPA: 200 {access_token<br/>(JWT), user}
        SPA->>SPA: Store token in<br/>localStorage<br/>#nbsp;
    end
    U->>SPA: Open Account / Digest /<br/>Admin page
    SPA->>PR: GET /api/users/me (Authorization: Bearer JWT)
    PR->>PR: Decode and<br/>verify JWT<br/>#nbsp;
    PR->>DB: Reload user<br/>(active? role?)
    alt valid and permitted
        PR-->>SPA: 200 response data
    else missing/invalid token or not admin
        PR-->>SPA: 401 or 403
    end
